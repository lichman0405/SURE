{
  "description": "SURE evidence/protection hooks for Cursor — Windows bootstrap template; release packaging must render/test per-platform launchers.",
  "hooks": {
    "sessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": ".\\scripts\\sure-hook.ps1 session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "preToolUse": [
      {
        "matcher": "Shell|Read|Write|Delete",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": ".\\scripts\\sure-hook.ps1 pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "postToolUse": [
      {
        "matcher": "Shell|Read|Write|Delete",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": ".\\scripts\\sure-hook.ps1 post-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "postToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": ".\\scripts\\sure-hook.ps1 post-tool-failure",
            "timeout": 10
          }
        ]
      }
    ],
    "afterFileEdit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": ".\\scripts\\sure-hook.ps1 after-file-edit",
            "timeout": 10
          }
        ]
      }
    ],
    "stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": ".\\scripts\\sure-hook.ps1 stop",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
