{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SURE AI Claim",
  "type": "object",
  "required": [
    "id",
    "claim_text",
    "assessment"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "claim_text": {
      "type": "string"
    },
    "claim_type": {
      "type": "string"
    },
    "assessment": {
      "enum": [
        "confirmed",
        "contradicted",
        "cannot_confirm",
        "not_checkable"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}