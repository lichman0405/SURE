{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SURE Harness Event",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "event_type",
    "timestamp"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": "string"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_type": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  }
}