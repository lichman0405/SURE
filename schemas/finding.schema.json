{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SURE Finding",
  "type": "object",
  "required": [
    "id",
    "title",
    "severity",
    "status",
    "explanation",
    "evidence",
    "assessment_source",
    "severity_rationale"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "must_fix",
        "should_fix_first",
        "can_fix_later",
        "note"
      ]
    },
    "status": {
      "enum": [
        "open",
        "resolved",
        "accepted_risk",
        "cannot_confirm"
      ]
    },
    "explanation": {
      "type": "string"
    },
    "user_impact": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "class",
          "summary",
          "anchor",
          "severity"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "class": {
            "enum": [
              "observed_fact",
              "deterministic_check",
              "model_assessment",
              "inference",
              "unknown"
            ]
          },
          "summary": {
            "type": "string"
          },
          "anchor": {
            "type": "object",
            "required": [
              "subject",
              "location",
              "locator"
            ],
            "properties": {
              "subject": {
                "enum": [
                  "file",
                  "directory",
                  "line_range",
                  "command",
                  "output",
                  "check",
                  "event",
                  "config",
                  "database",
                  "documentation",
                  "git",
                  "runtime",
                  "intent",
                  "claim",
                  "model"
                ]
              },
              "subject_id": {
                "type": "string"
              },
              "location": {
                "type": "string"
              },
              "locator": {
                "type": "string"
              },
              "excerpt": {
                "type": "string"
              }
            }
          },
          "fingerprint": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "must_fix",
              "should_fix_first",
              "can_fix_later",
              "note"
            ]
          }
        }
      }
    },
    "technical_details": {
      "type": "object"
    },
    "assessment_source": {
      "type": [
        "string",
        "object"
      ]
    },
    "severity_rationale": {
      "enum": [
        "blocks_hand_off",
        "reliability_or_quality_risk",
        "non_blocking_improvement",
        "informational"
      ]
    }
  }
}
